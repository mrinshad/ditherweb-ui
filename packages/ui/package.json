{
  "name": "@ditherweb/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "tsc -p tsconfig.build.json",
    "build:styles": "node scripts/copy-styles.mjs",
    "verify:directives": "node scripts/verify-client-directives.mjs",
    "build": "npm run clean && npm run build:js && npm run build:styles && npm run verify:directives",
    "test:consumer": "node scripts/test-consumer.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  }
}
