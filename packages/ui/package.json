{
  "name": "@ditherweb/ui",
  "version": "0.1.0",
  "description": "A modern React UI framework inspired by early-Internet and classic desktop computing visual language.",
  "license": "MIT",
  "author": "Ditherweb Contributors",
  "homepage": "https://github.com/mrinshad/ditherweb-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrinshad/ditherweb-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/mrinshad/ditherweb-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "retro",
    "dither",
    "dithering",
    "components",
    "tailwind",
    "tailwindcss",
    "design-system",
    "classic-desktop",
    "y2k",
    "rsc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "tsc -p tsconfig.build.json",
    "build:dts-maps": "node scripts/inline-declaration-sources.mjs",
    "build:styles": "node scripts/copy-styles.mjs",
    "verify:directives": "node scripts/verify-client-directives.mjs",
    "verify:snippets": "node scripts/verify-docs-snippets.mjs",
    "build": "npm run clean && npm run build:js && npm run build:dts-maps && npm run build:styles && npm run verify:directives",
    "test:consumer": "node scripts/test-consumer.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  }
}
