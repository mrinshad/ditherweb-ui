{
  "name": "ditherweb",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ditherweb/website",
    "build:ui": "npm run build --workspace=@ditherweb/ui",
    "build:website": "npm run build --workspace=@ditherweb/website",
    "build": "npm run build:ui && npm run build:website",
    "start": "npm run start --workspace=@ditherweb/website",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test:consumer": "npm run test:consumer --workspace=@ditherweb/ui",
    "test:snippets": "npm run verify:snippets --workspace=@ditherweb/ui",
    "test:package": "npm run build:ui && npm run test:consumer --workspace=@ditherweb/ui && npm run verify:snippets --workspace=@ditherweb/ui",
    "test": "npm run test:package"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
