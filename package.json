{
  "name": "ditherweb",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ditherweb/website",
    "build": "npm run build --workspace=@ditherweb/website",
    "start": "npm run start --workspace=@ditherweb/website",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
